# Movie Night Planner - Environment Variables (for local development only)
# DO NOT commit this file with real values!

# TMDB Access Token (Bearer Token)
# Get your access token at: https://www.themoviedb.org/settings/api
# Copy the "API Read Access Token" (starts with 'eyJ...')
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# NOTE: Embeddings use sentence-transformers (no API key required)
# The all-MiniLM-L6-v2 model runs locally and is completely free.

# For production/Databricks deployment, use Databricks secrets:
# 1. Run: python setup_secrets.py
# 2. Access in code:
#    tmdb_token = dbutils.secrets.get(scope='movie-planner', key='tmdb-access-token')
